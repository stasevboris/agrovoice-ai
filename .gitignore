# Reproducible downloaded phone examples and debug tensor dumps
/artifacts/field_photos/*.jpg
/docs/android/phone_validation/*.bin
/docs/android/phone_validation/fixtures/
/docs/android/accuracy_v1/field_validation/*.bin
/docs/android/accuracy_v1/field_validation/*.npy

# Reproducible official offline speech model; manifests and licenses stay versioned.
/android-app/app/src/main/assets/voice/ru/
/ml-pipeline/downloads/voice/

